---
import Layout from '../layouts/Layout.astro';
import HomeStima from '../components/HomeStima.jsx';
import { LUCE_TRIMESTRI } from '../data/stima-casa.js';
import { FONTE_TARI } from '../data/tari-2025.js';
import { TASSI, fmtPerc } from '../data/tassi.js';
import { LUCE } from '../data/energia.js';
import { GUIDE } from '../data/guide.js';
const inEvidenza = ['costi-casa', 'spese-condominiali', 'bolletta-luce', 'detrazione-interessi-mutuo'].map((s) => GUIDE.find((g) => g.slug === s));
const [q3, q4] = LUCE_TRIMESTRI.slice(-2);
const varLuce = (q4.p / q3.p - 1) * 100;
const varTari = (FONTE_TARI.media / FONTE_TARI.media2024 - 1) * 100;
const pct = (n, d = 1) => (n > 0 ? '+' : '') + n.toFixed(d).replace('.', ',') + '%';
const numeri = [
  { href: '/guida/bolletta-luce-media', k: 'Luce', v: q4.p.toFixed(2).replace('.', ','), u: 'c€/kWh', d: pct(varLuce), su: varLuce > 0, t: `Prezzo di riferimento ARERA, ${q4.t}. Era ${q3.p.toFixed(2).replace('.', ',')} nel trimestre prima.` },
  { href: '/tari', k: 'TARI', v: String(FONTE_TARI.media), u: '€ l\'anno', d: pct(varTari), su: varTari > 0, t: `Media dei capoluoghi per 3 persone in 100 m². Nel 2024 era ${FONTE_TARI.media2024} €.` },
  { href: '/mutuo', k: 'Mutuo', v: fmtPerc(TASSI.fisso).replace('%', ''), u: '% fisso', d: `variabile ${fmtPerc(TASSI.variabile)}`, su: null, t: `TAN medio delle offerte prima casa, ${TASSI.aggiornatoTesto}. Fonte: ${TASSI.fonte.split(':')[0]}.` },
];
const schemaHome = [{
  '@type': 'WebApplication', name: 'SoldiBuoni · La tua casa', url: 'https://soldibuoni.it/casa',
  applicationCategory: 'FinanceApplication', operatingSystem: 'Web', inLanguage: 'it-IT',
  description: 'Gestione delle spese di casa: lettura automatica delle bollette, scadenzario, avvisi su promozioni e rinnovi, riepilogo settimanale via email.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
}];
---
<Layout
  schema={schemaHome}
  title="Gestione spese di casa: bollette, mutuo, condominio | SoldiBuoni"
  description="App gratuita per le spese di casa: carichi le bollette, le leggiamo noi e ti avvisiamo prima di ogni scadenza. Mutuo, condominio, TARI, IMU in un posto solo."
>
  <section class="hero" id="stima">
    <div class="wrap">
      <div class="hero-head">
        <p class="kicker"><span>N° 01</span> La tua casa, in un numero</p>
        <h1 class="display hero-t">Quanto costa<br />una casa <em>come la tua?</em></h1>
        <p class="hero-s">Tre risposte, e vedi subito quanto spendi di luce, gas e TARI nella tua città, ai prezzi di oggi. Poi, con le tue bollette, diventa il conto vero.</p>
      </div>
      <HomeStima client:load />
    </div>
  </section>

  <section class="numeri" aria-labelledby="numeri-t">
    <div class="wrap">
      <div class="guides-hd"><p class="kicker" id="numeri-t"><span>N° 02</span> I numeri del mese</p></div>
      <div class="num-g">
        {numeri.map((n) => (
          <a href={n.href} class="num-c">
            <span class="num-k">{n.k}</span>
            <span class="num-v"><b>{n.v}</b> {n.u}</span>
            <span class:list={['num-d', { su: n.su === true, giu: n.su === false }]}>{n.su === true ? '▲ ' : n.su === false ? '▼ ' : ''}{n.d}</span>
            <span class="num-t">{n.t}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="settimana" class="week">
    <div class="wrap week-in">
      <div class="week-copy">
        <p class="kicker"><span>N° 03</span> La tua casa</p>
        <h2 class="display sec-t">Crea la tua casa,<br /><em>e i conti si fanno da soli.</em></h2>
        <p class="sec-s">Carichi bollette, condominio, TARI e rate così come arrivano: PDF o foto, li leggiamo noi. Vedi quanto costa la casa voce per voce, cosa sale e cosa scende, in quali mesi pesa. Ogni lunedì un'email con cosa esce.</p>
        <div class="hero-cta">
          <a href="/casa" class="btn btn-ink btn-lg">Crea la tua casa <span aria-hidden="true">→</span></a>
          <a class="hero-link" href="/controlla-bolletta">Prima prova con una bolletta</a>
        </div>
        <p class="week-n">Gratis, senza password: entri con un codice via email.</p>
      </div>
      <div class="ticket" aria-label="Esempio di settimana">
        <div class="ticket-hd">
          <span>Settimana 48</span><span>Esempio</span>
        </div>
        <p class="ticket-t">Questa settimana escono</p>
        <p class="ticket-n"><span class="eur">€</span>1.064<small>,70</small></p>
        <ul class="ticket-list">
          <li><time>lun 1</time><span>Rata mutuo<em>addebito automatico</em></span><b>€ 780,00</b></li>
          <li><time>gio 4</time><span>Gas · Hera<em>da pagare</em></span><b>€ 284,70</b></li>
        </ul>
        <div class="ticket-todo">
          <p class="ticket-k">Da fare</p>
          <p><i></i>Le condizioni della luce scadono tra 24 giorni: confronta prima del rinnovo.</p>
          <p><i></i>Bolletta gas su consumi stimati: manda l'autolettura.</p>
        </div>
        <div class="ticket-ft">Prossimo: condominio, 13 dicembre</div>
      </div>
    </div>
  </section>

  <section class="guides">
    <div class="wrap">
      <div class="guides-hd">
        <p class="kicker"><span>N° 04</span> Le guide</p>
        <a href="/guida" class="hero-link">Tutte le guide</a>
      </div>
      <div class="guides-list">
        {inEvidenza.map((g, i) => (
          <a href={`/guida/${g.slug}`} class="g-item"><span class="g-n">{String(i + 1).padStart(2, '0')}</span><h3>{g.t}</h3><p>{g.d}</p></a>
        ))}
      </div>
    </div>
  </section>

  <section class="hubs" aria-labelledby="hubs-t">
    <div class="wrap">
      <div class="guides-hd">
        <p class="kicker" id="hubs-t"><span>N° 05</span> I costi della casa, voce per voce</p>
      </div>
      <div class="hubs-g">
        <a href="/costi-casa" class="hub-c"><span class="hub-k">Costi</span><span class="hub-t">Quanto costa mantenere una casa</span><span class="hub-d">Voce per voce, con le fonti ufficiali.</span></a>
        <a href="/bollette" class="hub-c"><span class="hub-k">Bollette</span><span class="hub-t">Luce e gas: i prezzi di oggi</span><span class="hub-d">Il riferimento ARERA e come leggere la tua.</span></a>
        <a href="/tari" class="hub-c"><span class="hub-k">TARI</span><span class="hub-t">La TARI in 110 città</span><span class="hub-d">Da 196 € a Cremona a 602 € a Catania.</span></a>
        <a href="/famiglia" class="hub-c"><span class="hub-k">Famiglia</span><span class="hub-t">Quanto spende una famiglia</span><span class="hub-d">I dati ISTAT e come dividere le spese.</span></a>
      </div>
    </div>
  </section>

  <section class="tools">
    <div class="wrap">
      <div class="guides-hd">
        <p class="kicker"><span>N° 06</span> Strumenti</p>
        <a href="/strumenti" class="hero-link">Tutti gli strumenti</a>
      </div>
      <div class="hubs-g">
        <a href="/controlla-bolletta" class="hub-c"><span class="hub-k">Bolletta</span><span class="hub-t">Controlla la tua bolletta</span><span class="hub-d">Quanto paghi davvero al kWh. Dieci secondi.</span></a>
        <a href="/dividi" class="hub-c"><span class="hub-k">Insieme</span><span class="hub-t">Dividi le spese</span><span class="hub-d">Coinquilini o coppia: chi deve a chi.</span></a>
        <a href="/mutuo" class="hub-c"><span class="hub-k">Mutuo</span><span class="hub-t">La rata del mutuo</span><span class="hub-d">Con i tassi di questo mese.</span></a>
        <a href="/affitto-vs-mutuo" class="hub-c"><span class="hub-k">Decidere</span><span class="hub-t">Affitto o mutuo</span><span class="hub-d">Quando conviene comprare invece di restare in affitto.</span></a>
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="wrap man-in">
      <h2 class="display man-t">Nessuno ci paga<br />per consigliarti<br /><em>un fornitore.</em></h2>
      <div class="man-b">
        <p>Niente affiliazioni, niente pubblicità, niente offerte sponsorizzate. Ti diciamo quanto paghi e perché; cosa fare lo decidi tu.</p>
        <ul>
          <li>I documenti che carichi non li conserviamo: teniamo solo i numeri.</li>
          <li>Nome, indirizzo, codice fiscale, POD, PDR e IBAN non vengono estratti.</li>
          <li>I dati della casa stanno su server in Unione Europea, visibili solo a te e a chi inviti. Li esporti o li cancelli quando vuoi.</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .kicker { display: flex; align-items: baseline; gap: 14px; font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-2); font-weight: 500; }
  .kicker span { font-family: var(--f-display); font-style: italic; text-transform: none; letter-spacing: 0; font-size: 17px; color: var(--brass); }
  .btn-lg { height: 54px; padding: 0 26px; font-size: 16px; }
  .hero-link { font-size: 15.5px; color: var(--ink); text-decoration: underline; text-decoration-color: var(--brass); text-underline-offset: 5px; }

  /* hero */
  .hero { padding: clamp(40px, 6vw, 88px) 0 clamp(56px, 7vw, 96px); border-bottom: 1px solid var(--ink); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .hero-t { font-size: clamp(58px, 8.2vw, 124px); line-height: .9; letter-spacing: -0.045em; margin: 28px 0 32px; font-weight: 400; }
  .hero-t em { font-style: italic; color: var(--brass); }
  .hero-s { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; max-width: 500px; color: var(--ink-2); }
  .hero-cb { display: inline-block; margin-top: 18px; font-size: 15px; color: var(--ink-2); text-decoration: none; }
  .hero-cb b { color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--brass); }
  .hero-cb:hover b { text-decoration-thickness: 2px; }
  .hero-cta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 36px; }
  .hero-app { gap: 10px; }
  .in-app .hero-app { display: none; }
  .hero-passi { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 44px; max-width: 560px; border-top: 1px solid var(--ink); counter-reset: p; }
  .hero-passi li { display: flex; gap: 10px; padding: 16px 14px 0 0; }
  .hero-passi li + li { padding-left: 14px; border-left: 1px solid var(--line-strong); }
  .hero-passi span { font-family: var(--f-display); font-style: italic; color: var(--brass); font-size: 20px; line-height: 1.1; }
  .hero-passi p { font-size: 13.5px; line-height: 1.4; color: var(--ink-2); }
  .hero-passi b { display: block; font-size: 15px; font-weight: 600; color: var(--ink); margin-bottom: 3px; }
  @media (max-width: 560px) {
    .hero-passi { grid-template-columns: 1fr; }
    .hero-passi li, .hero-passi li + li { padding: 14px 0; border-left: 0; border-bottom: 1px solid var(--line); }
    .hero-cta .btn { flex: 1 1 auto; justify-content: center; }
  }
  .hero-facts { list-style: none; display: flex; gap: 0; margin-top: 48px; border-top: 1px solid var(--line-strong); max-width: 520px; }
  .hero-facts li { flex: 1; padding: 16px 16px 0 0; font-size: 13.5px; color: var(--ink-3); line-height: 1.35; }
  .hero-facts li + li { padding-left: 16px; border-left: 1px solid var(--line); }
  .hero-facts b { display: block; font-family: var(--f-display); font-weight: 500; font-size: 40px; color: var(--ink); line-height: 1; margin-bottom: 6px; }
  .hero-tav { max-width: 560px; justify-self: end; width: 100%; }

  /* settimana */
  .week { padding: clamp(80px, 10vw, 140px) 0; }
  .week-in { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
  .sec-t { font-size: clamp(42px, 5.4vw, 76px); line-height: .95; letter-spacing: -0.04em; margin: 22px 0 26px; }
  .sec-t em { font-style: italic; color: var(--brass); }
  .sec-s { font-size: 18px; max-width: 520px; }
  .ticket { background: var(--card); border: 1px solid var(--ink); border-radius: 4px; padding: 28px 28px 22px; box-shadow: 10px 10px 0 var(--paper-2), 10px 10px 0 1px var(--ink); transform: rotate(-1.2deg); max-width: 440px; justify-self: center; }
  .ticket-hd { display: flex; justify-content: space-between; font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); padding-bottom: 14px; border-bottom: 1px dashed var(--line-strong); }
  .ticket-t { margin-top: 22px; font-size: 14px; color: var(--ink-2); }
  .ticket-n { font-family: var(--f-display); font-size: 64px; line-height: 1; color: var(--ink); letter-spacing: -0.03em; margin: 6px 0 18px; }
  .ticket-n .eur { font-family: var(--f-ui); font-size: 28px; color: var(--ink-3); margin-right: 8px; vertical-align: 0.6em; }
  .ticket-n small { font-size: 30px; color: var(--ink-3); }
  .ticket-list { list-style: none; border-top: 1px solid var(--ink); }
  .ticket-list li { display: grid; grid-template-columns: 52px 1fr auto; gap: 10px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15px; color: var(--ink); }
  .ticket-list time { font-size: 12px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; }
  .ticket-list em { display: block; font-style: normal; font-size: 12.5px; color: var(--ink-3); }
  .ticket-list b { font-weight: 500; font-variant-numeric: tabular-nums; }
  .ticket-todo { margin-top: 18px; font-size: 14px; color: var(--ink-2); }
  .ticket-todo p { display: flex; gap: 10px; margin-top: 8px; line-height: 1.45; }
  .ticket-todo i { flex-shrink: 0; width: 14px; height: 14px; margin-top: 3px; border: 1.3px solid var(--ink); border-radius: 3px; }
  .ticket-k { font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--warn); font-weight: 600; }
  .ticket-ft { margin-top: 20px; padding-top: 14px; border-top: 1px dashed var(--line-strong); font-family: var(--f-display); font-style: italic; color: var(--brass); font-size: 16px; }

  /* come */
  .how { padding: clamp(72px, 9vw, 120px) 0; border-top: 1px solid var(--ink); }
  .how-list { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 48px; }
  .how-list li { padding: 0 32px 8px 0; }
  .how-list li + li { padding-left: 32px; border-left: 1px solid var(--line-strong); }
  .how-n { display: block; font-family: var(--f-display); font-style: italic; font-size: 72px; line-height: 1; color: var(--brass); margin-bottom: 24px; }
  .how-list h3 { font-family: var(--f-display); font-weight: 500; font-size: 30px; line-height: 1.05; color: var(--ink); letter-spacing: -0.02em; margin-bottom: 14px; }
  .how-list p { font-size: 16.5px; }

  /* manifesto */
  .manifesto { background: var(--ink); color: rgba(245, 242, 236, .76); padding: clamp(80px, 10vw, 140px) 0; }
  .man-in { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: end; }
  .man-t { color: var(--paper); font-size: clamp(42px, 5.4vw, 80px); line-height: .95; letter-spacing: -0.04em; }
  .man-t em { font-style: italic; color: #d9c49b; }
  .man-b p { font-size: 19px; color: var(--paper); margin-bottom: 28px; line-height: 1.5; }
  .man-b ul { list-style: none; }
  .man-b li { padding: 14px 0; border-top: 1px solid rgba(245, 242, 236, .18); font-size: 15.5px; }

  /* guide */
  .guides { padding: clamp(72px, 9vw, 120px) 0 0; }
  .guides-hd { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; }
  .guides-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .g-item { padding: 24px 24px 32px 0; transition: background .3s var(--ease); }
  .g-item + .g-item { padding-left: 24px; border-left: 1px solid var(--line-strong); }
  .g-n { font-size: 12.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .g-item h3 { font-family: var(--f-display); font-weight: 500; font-size: 26px; line-height: 1.08; letter-spacing: -0.02em; color: var(--ink); margin: 18px 0 12px; }
  .g-item p { font-size: 15px; }
  .g-item:hover h3 { font-style: italic; color: var(--brass); }

  /* chiusura */
  .next { padding: clamp(80px, 10vw, 140px) 0 0; }
  .next-in { border-top: 1px solid var(--ink); padding-top: 40px; }
  .next-t { font-size: clamp(36px, 5vw, 68px); line-height: 1; letter-spacing: -0.035em; max-width: 1000px; margin: 24px 0 40px; }
  .next-t em { font-style: italic; color: var(--brass); }

  @media (max-width: 960px) {
    .hero-in, .week-in, .man-in { grid-template-columns: 1fr; }
    .hero-tav { justify-self: stretch; max-width: 520px; }
    .ticket { justify-self: start; transform: rotate(-.8deg); }
    .how-list { grid-template-columns: 1fr; }
    .how-list li, .how-list li + li { padding: 28px 0; border-left: 0; border-top: 1px solid var(--line-strong); }
    .how-n { font-size: 52px; margin-bottom: 12px; }
    .guides-list { grid-template-columns: 1fr 1fr; }
    .g-item:nth-child(3) { padding-left: 0; border-left: 0; }
    .g-item { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .guides-list { grid-template-columns: 1fr; }
    .g-item, .g-item + .g-item { padding: 22px 0; border-left: 0; }
    .hero-facts b { font-size: 32px; }
  }
  .hubs { padding: clamp(56px, 8vw, 96px) 0 0; }
  .hubs-g { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .hub-c { display: flex; flex-direction: column; gap: 8px; padding: 24px 22px 28px 0; color: var(--ink); }
  .hub-c + .hub-c { padding-left: 22px; border-left: 1px solid var(--line-strong); }
  .hub-k { font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--brass); }
  .hub-t { font-family: var(--f-display); font-size: clamp(24px, 2.4vw, 30px); line-height: 1.08; letter-spacing: -0.02em; }
  .hub-d { font-size: 15px; color: var(--ink-2); }
  .hub-c:hover .hub-t { text-decoration: underline; text-decoration-color: var(--brass); text-underline-offset: 4px; }
  @media (max-width: 900px) { .hubs-g { grid-template-columns: 1fr 1fr; } .hub-c:nth-child(3) { padding-left: 0; border-left: 0; } .hub-c { border-bottom: 1px solid var(--line); } }
  @media (max-width: 560px) { .hubs-g { grid-template-columns: 1fr; } .hub-c, .hub-c + .hub-c { padding-left: 0; border-left: 0; } }

  /* hero con la stima */
  .hero-head { max-width: 900px; margin-bottom: clamp(28px, 4vw, 48px); }
  .hero-head .hero-t { margin: 22px 0 22px; font-size: clamp(52px, 7.6vw, 112px); }
  :global(.hs) { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(20px, 3vw, 40px); align-items: start; }
  :global(.hs-q) { display: grid; gap: 22px; padding: clamp(20px, 2.6vw, 32px); border: 1px solid var(--ink); border-radius: var(--r-lg); background: var(--card); }
  :global(.hs-f) { display: grid; gap: 10px; border: 0; padding: 0; margin: 0; min-width: 0; }
  :global(.hs-f > span), :global(.hs-f legend) { font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); font-weight: 500; padding: 0; margin-bottom: 10px; }
  :global(.hs-f input) { height: 54px; border: 1px solid var(--line-strong); border-radius: 12px; background: var(--paper); padding: 0 16px; font: inherit; font-size: 19px; color: var(--ink); width: 100%; }
  :global(.hs-f input:focus) { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px var(--paper-2); }
  :global(.hs-seg) { display: flex; flex-wrap: wrap; gap: 6px; }
  :global(.hs-seg button) { flex: 1 1 auto; min-width: 48px; height: 46px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--line-strong); background: var(--paper); color: var(--ink-2); font: inherit; font-size: 15.5px; cursor: pointer; transition: background .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease); }
  :global(.hs-seg button:hover) { border-color: var(--ink); color: var(--ink); }
  :global(.hs-seg button.on) { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  :global(.hs-seg button:focus-visible) { outline: 2px solid var(--brass); outline-offset: 2px; }
  :global(.hs-r) { padding: clamp(22px, 3vw, 40px); border-radius: var(--r-lg); background: var(--ink); color: rgba(245, 242, 236, .78); }
