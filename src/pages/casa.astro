---
import Layout from '../layouts/Layout.astro';
import CasaApp from '../components/casa/CasaApp.jsx';
import '../styles/casa.css';
---
<Layout
  title="Scadenzario spese di casa gratis: bollette, mutuo, condominio | SoldiBuoni"
  description="Carica le bollette con una foto: SoldiBuoni legge importi, consumi e scadenze, calcola il costo mensile della casa e ti avvisa prima di pagamenti, fine promozioni e rinnovi. Gratis, nessuna pubblicità."
  app
>
  <CasaApp client:only="react" />
  <noscript><div class="wrap" style="padding:64px 0">Per usare “La tua casa” serve JavaScript attivo.</div></noscript>
</Layout>
