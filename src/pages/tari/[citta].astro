---
import Layout from '../../layouts/Layout.astro';
import { TARI, FONTE_TARI } from '../../data/tari-2025.js';

export function getStaticPaths() {
  return TARI.map((t) => ({ params: { citta: t.slug } }));
}

const { citta } = Astro.params;
const ordinate = TARI; // già in ordine decrescente
const t = ordinate.find((x) => x.slug === citta);
const pos = ordinate.indexOf(t) + 1;
const tot = ordinate.length;
const regione = ordinate.filter((x) => x.regione === t.regione);
const posReg = regione.indexOf(t) + 1;
const media = FONTE_TARI.media;
const mediaArea = FONTE_TARI.aree[t.area];
const diff = t.t25 - media;
const diffPct = Math.round((diff / media) * 100);
const diffArea = t.t25 - mediaArea;
const mese = (t.t25 / 12).toFixed(2).replace('.', ',');
const eur = (n) => n.toLocaleString('it-IT');
const pct = (n) => (n > 0 ? '+' : '') + n.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
const segno = t.var > 0.05 ? 'aumentata' : t.var < -0.05 ? 'diminuita' : 'rimasta stabile';
const fascia = pos <= 10 ? 'tra le dieci più care d\'Italia' : pos > tot - 10 ? 'tra le dieci più economiche d\'Italia' : pos <= tot / 3 ? 'nel terzo più caro dei capoluoghi' : pos > (2 * tot) / 3 ? 'nel terzo più economico dei capoluoghi' : 'a metà classifica';
const sopraSotto = Math.abs(diffPct) < 3 ? 'in linea con la media nazionale' : diff > 0 ? `il ${diffPct}% sopra la media nazionale` : `il ${Math.abs(diffPct)}% sotto la media nazionale`;
const vicine = ordinate.filter((x) => x.slug !== t.slug && x.area === t.area).sort((a, b) => Math.abs(a.t25 - t.t25) - Math.abs(b.t25 - t.t25)).slice(0, 4);
const maxBar = ordinate[0].t25;
const url = `https://soldibuoni.it/tari/${t.slug}`;

const title = `TARI ${t.citta} 2025: quanto paga una famiglia | SoldiBuoni`;
const description = `A ${t.citta} una famiglia di 3 persone in 100 m² paga ${eur(t.t25)} € di TARI l'anno (${pct(t.var)} sul 2024). Confronto con media italiana e altre città.`;

const faq = [
  { q: `Quanto costa la TARI a ${t.citta}?`, a: `Per una famiglia di 3 persone in una casa di 100 m² la TARI 2025 a ${t.citta} è di ${eur(t.t25)} euro l'anno, circa ${mese} euro al mese. Il dato è dell'Osservatorio Prezzi & Tariffe di Cittadinanzattiva (${FONTE_TARI.data}).` },
  { q: `La TARI a ${t.citta} è aumentata?`, a: `Rispetto al 2024 (${eur(t.t24)} euro) la TARI per la famiglia tipo è ${segno}: ${pct(t.var)}. In media in Italia l'aumento è stato del 3,3%.` },
  { q: `${t.citta} è una città cara per la TARI?`, a: `Con ${eur(t.t25)} euro ${t.citta} è al ${pos}° posto su ${tot} capoluoghi, ${fascia}: ${sopraSotto} (${eur(media)} euro). In ${t.regione} è al ${posReg}° posto su ${regione.length}.` },
  { q: `Quanto pago io di TARI a ${t.citta}?`, a: `Dipende dai metri quadri e dal numero di persone in casa: il Comune applica una quota fissa sulla superficie e una variabile sui componenti. L'importo esatto è sull'avviso del Comune; quello della famiglia tipo serve per confrontare le città.` },
];

const schema = [
  {
    '@type': 'Dataset', name: `TARI 2025 a ${t.citta} per una famiglia tipo`, url,
    description: `Importo annuo della TARI 2025 a ${t.citta} per una famiglia di 3 persone in un'abitazione di proprietà di 100 m², con confronto 2024.`,
    temporalCoverage: '2024/2025', spatialCoverage: { '@type': 'Place', name: `${t.citta}, ${t.regione}, Italia` },
    creator: { '@type': 'Organization', name: 'Cittadinanzattiva – Osservatorio Prezzi & Tariffe' },
    publisher: { '@id': 'https://soldibuoni.it/#org' }, isAccessibleForFree: true, inLanguage: 'it-IT',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'SoldiBuoni', item: 'https://soldibuoni.it/' },
      { '@type': 'ListItem', position: 2, name: 'Tasse sulla casa', item: 'https://soldibuoni.it/tasse-casa' },
      { '@type': 'ListItem', position: 3, name: 'TARI per città', item: 'https://soldibuoni.it/tari' },
      { '@type': 'ListItem', position: 4, name: `TARI ${t.citta}`, item: url },
    ],
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Layout title={title} description={description} schema={schema} tipo="article">
  <article class="tc wrap">
    <nav class="tc-bc" aria-label="Percorso"><a href="/">SoldiBuoni</a> <span aria-hidden="true">/</span> <a href="/tasse-casa">Tasse sulla casa</a> <span aria-hidden="true">/</span> <a href="/tari">TARI per città</a> <span aria-hidden="true">/</span> {t.citta}</nav>

    <header class="tc-hd">
      <p class="eyebrow">TARI 2025 · {t.regione}</p>
      <h1 class="display tc-t">La TARI a {t.citta}</h1>
      <p class="tc-lead">Una famiglia di tre persone in una casa di 100 m² paga <strong>{eur(t.t25)} € l'anno</strong>, cioè circa {mese} € al mese. È {sopraSotto} e {t.citta} è {fascia}.</p>
    </header>

    <section class="tc-cards" aria-label="I numeri">
      <div class="tc-card tc-main">
        <span class="tc-k">TARI 2025, famiglia tipo</span>
        <span class="tc-v num">{eur(t.t25)}<span class="tc-u">€/anno</span></span>
        <span class="tc-s">{pct(t.var)} rispetto al 2024 ({eur(t.t24)} €)</span>
      </div>
      <div class="tc-card">
        <span class="tc-k">Classifica</span>
        <span class="tc-v num">{pos}°<span class="tc-u">su {tot}</span></span>
        <span class="tc-s">1° = la più cara · {posReg}° su {regione.length} in {t.regione}</span>
      </div>
      <div class="tc-card">
        <span class="tc-k">Rispetto alla media</span>
        <span class={'tc-v num ' + (diff > 0 ? 'up' : 'down')}>{diff > 0 ? '+' : diff < 0 ? '−' : ''}{eur(Math.abs(diff))}<span class="tc-u">€</span></span>
        <span class="tc-s">Italia {eur(media)} € · {t.area} {eur(mediaArea)} € ({diffArea >= 0 ? '+' : '−'}{eur(Math.abs(diffArea))} €)</span>
      </div>
    </section>

    <div class="tc-body">
      <div class="prose">
        <h2>{t.citta} a confronto</h2>
        <p>Le barre mostrano la TARI della famiglia tipo nelle città dell'area {t.area} con l'importo più vicino a {t.citta}, insieme alla media italiana e al capoluogo più caro e a quello più economico.</p>
        <div class="tc-bars" role="img" aria-label={`TARI 2025 a ${t.citta} confrontata con altre città`}>
          {[ordinate[0], t, ...vicine, ordinate[tot - 1]].filter((x, i, a) => a.findIndex((y) => y.slug === x.slug) === i).sort((a, b) => b.t25 - a.t25).map((x) => (
            <div class={'tc-bar' + (x.slug === t.slug ? ' on' : '')}>
              <span class="tc-bar-l">{x.slug === t.slug ? <strong>{x.citta}</strong> : <a href={`/tari/${x.slug}`}>{x.citta}</a>}</span>
              <span class="tc-bar-t"><span class="tc-bar-f" style={`width:${(x.t25 / maxBar) * 100}%`}></span></span>
              <span class="tc-bar-v num">{eur(x.t25)} €</span>
            </div>
          ))}
          <div class="tc-bar avg">
            <span class="tc-bar-l">Media Italia</span>
            <span class="tc-bar-t"><span class="tc-bar-f" style={`width:${(media / maxBar) * 100}%`}></span></span>
            <span class="tc-bar-v num">{eur(media)} €</span>
          </div>
        </div>

        <h2>Le altre città della regione {t.regione}</h2>
        <table>
          <thead><tr><th>Capoluogo</th><th>TARI 2025</th><th>TARI 2024</th><th>Variazione</th></tr></thead>
          <tbody>
            {regione.map((x) => (
              <tr class={x.slug === t.slug ? 'tc-row-on' : ''}>
                <td>{x.slug === t.slug ? <strong>{x.citta}</strong> : <a href={`/tari/${x.slug}`}>{x.citta}</a>}</td>
                <td class="num">{eur(x.t25)} €</td>
                <td class="num">{eur(x.t24)} €</td>
                <td class="num">{pct(x.var)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <h2>Perché la tua TARI può essere diversa</h2>
        <p>Il numero di questa pagina è quello di una <strong>famiglia tipo</strong>: tre persone in una casa di proprietà di 100 m². Serve a confrontare le città, non a sapere quanto pagherai tu. Il Comune di {t.citta} calcola la TARI con due parti:</p>
        <ul>
          <li><strong>quota fissa</strong>, in base ai metri quadri calpestabili della casa;</li>
          <li><strong>quota variabile</strong>, in base al numero di persone che ci vivono.</li>
        </ul>
        <p>Chi vive da solo in un bilocale paga di solito meno della famiglia tipo; una famiglia di cinque persone in una casa grande paga di più. Riduzioni per compostaggio, abitazioni con un solo occupante o case tenute a disposizione dipendono dal regolamento del Comune.</p>

        <h2>Scadenze e bonus</h2>
        <p>Rate e date le decide ogni Comune e sono scritte sull'avviso di pagamento, insieme ai modelli F24 o PagoPA già compilati. Dal 2026 le famiglie con ISEE fino a 9.796 euro (20.000 con almeno quattro figli a carico) hanno uno sconto del 25%, applicato senza domanda. Tutti i dettagli sono nella <a href="/guida/tari">guida alla TARI</a>.</p>

        <h2>Domande frequenti</h2>
        {faq.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}

        <p class="tc-src">Fonte: <a href={FONTE_TARI.url} rel="noopener">{FONTE_TARI.nome}</a>, {FONTE_TARI.data}. Importi annui per una famiglia di 3 persone in un'abitazione di proprietà di 100 m², comprensivi di IVA e addizionali. Altre rilevazioni (per esempio UIL o Utilitalia) usano ipotesi diverse e arrivano a cifre diverse. Aggiorneremo la pagina con il rapporto 2026.</p>
      </div>
      <aside class="tc-side">
        <div class="tc-cta">
          <p class="display tc-cta-t">Non dimenticare la rata.</p>
          <p>Aggiungi la TARI in La tua casa: ti avvisiamo qualche giorno prima di ogni scadenza, insieme a bollette, IMU e condominio.</p>
          <a href="/casa" class="btn btn-ink">Apri La tua casa</a>
          <a href="/tari" class="tc-cta-l">Classifica di tutte le città</a>
        </div>
      </aside>
    </div>
  </article>
</Layout>
<style>
  .tc { padding-top: 40px; }
  .tc-bc { font-size: 14px; color: var(--ink-3); }
  .tc-bc a { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .tc-hd { padding: 28px 0 32px; }
  .tc-t { font-size: clamp(44px, 7vw, 88px); line-height: .95; letter-spacing: -0.04em; margin-top: 12px; }
  .tc-lead { font-size: clamp(18px, 1.8vw, 21px); max-width: 720px; margin-top: 22px; color: var(--ink-2); }
  .tc-cards { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 16px; padding-bottom: 40px; border-bottom: 1px solid var(--ink); margin-bottom: 40px; }
  .tc-card { display: flex; flex-direction: column; gap: 8px; padding: 22px 24px; border: 1px solid var(--line-strong); border-radius: var(--r-lg); background: var(--card); }
  .tc-main { border-color: var(--ink); }
  .tc-k { font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .tc-v { font-family: var(--f-ui); font-weight: 700; font-size: clamp(36px, 4.4vw, 52px); line-height: 1; color: var(--ink); letter-spacing: -0.02em; }
  .tc-v.up { color: var(--warn); } .tc-v.down { color: var(--ok); }
  .tc-u { font-size: 15px; font-weight: 500; color: var(--ink-3); margin-left: 6px; letter-spacing: 0; }
  .tc-s { font-size: 14px; color: var(--ink-2); }
  .tc-body { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 64px; }
  .tc-body .prose > :first-child { margin-top: 0; }
  .tc-bars { display: flex; flex-direction: column; gap: 10px; margin: 20px 0 8px; }
  .tc-bar { display: grid; grid-template-columns: 130px 1fr 72px; gap: 12px; align-items: center; font-size: 15px; }
  .tc-bar-l a { color: var(--ink-2); }
  .tc-bar-t { height: 12px; background: var(--line); border-radius: 6px; overflow: hidden; }
  .tc-bar-f { display: block; height: 100%; background: var(--ink-3); border-radius: 6px; }
  .tc-bar.on .tc-bar-f { background: var(--brass); }
  .tc-bar.avg .tc-bar-f { background: transparent; border: 1px dashed var(--ink-2); box-sizing: border-box; }
  .tc-bar-v { text-align: right; color: var(--ink); }
  .tc-row-on td { background: color-mix(in srgb, var(--brass) 10%, transparent); }
  .tc-src { font-size: 13.5px; color: var(--ink-3); margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); }
  .tc-side { position: relative; }
  .tc-cta { position: sticky; top: 100px; background: var(--card); border: 1px solid var(--ink); border-radius: var(--r-lg); padding: 24px; font-size: 15px; }
  .tc-cta-t { font-size: 30px; margin-bottom: 10px; }
  .tc-cta .btn { margin-top: 18px; width: 100%; justify-content: center; }
  .tc-cta-l { display: block; margin-top: 12px; text-align: center; font-size: 14px; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--brass); }
  @media (max-width: 900px) {
    .tc-cards { grid-template-columns: 1fr; }
    .tc-body { grid-template-columns: 1fr; gap: 40px; }
    .tc-bar { grid-template-columns: 96px 1fr 64px; font-size: 14px; }
  }
</style>
