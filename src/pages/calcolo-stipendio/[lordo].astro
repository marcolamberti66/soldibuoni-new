---
import Layout from '../../layouts/Layout.astro';
import { TASSI } from '../../data/tassi.js';
import { ISTAT } from '../../data/energia.js';

// Forza il pre-render statico al build (compatibile sia con modalità
// static che hybrid/server). Necessario su Netlify in modalità SSR.
export const prerender = true;

// =====================================================================
// LISTA STIPENDI TARGET — coda lunga delle ricerche Google su stipendio
// netto in Italia. Ogni voce genera una pagina statica al build time.
// =====================================================================
export async function getStaticPaths() {
  // Ogni 1.000 € tra 15.000 e 50.000 (le ricerche più frequenti, una per importo), poi a salti.
  const stipendi = [
    ...Array.from({ length: 36 }, (_, i) => 15000 + i * 1000),
    55000, 60000, 65000, 70000, 75000, 80000, 85000, 90000, 100000, 120000, 150000,
  ];

  return stipendi.map((s, idx) => ({
    params: { lordo: `${s}-euro-lordi` },
    props: {
      ral: s,
      prev: idx > 0 ? stipendi[idx - 1] : null,
      next: idx < stipendi.length - 1 ? stipendi[idx + 1] : null,
      tutti: stipendi
    }
  }));
}

// =====================================================================
// LOGICA DI CALCOLO — basata su normativa fiscale italiana 2026
// Riferimenti: L. 199/2025 (Legge di Bilancio 2026), art. 13 TUIR,
// L. 335/1995 (massimale contributivo INPS).
// =====================================================================
function calcolaStipendio(ral) {
  // ----- Contributi INPS dipendente -----
  // 9,19% standard + 1% sopra €56.224 + nessun versamento sopra €122.295
  const SOGLIA_1PCT = 56224;
  const MASSIMALE_INPS = 122295;
  let inps;
  if (ral <= SOGLIA_1PCT) {
    inps = ral * 0.0919;
  } else if (ral <= MASSIMALE_INPS) {
    inps = SOGLIA_1PCT * 0.0919 + (ral - SOGLIA_1PCT) * 0.1019;
  } else {
    inps = SOGLIA_1PCT * 0.0919 + (MASSIMALE_INPS - SOGLIA_1PCT) * 0.1019;
  }

  // ----- Imponibile fiscale -----
  const imponibile = ral - inps;

  // ----- IRPEF lorda — scaglioni 2026 (23% / 33% / 43%) -----
  let irpefLorda = 0;
  if (imponibile <= 8500) {
    irpefLorda = 0; // No tax area
  } else if (imponibile <= 28000) {
    irpefLorda = imponibile * 0.23;
  } else if (imponibile <= 50000) {
    irpefLorda = 28000 * 0.23 + (imponibile - 28000) * 0.33;
  } else {
    irpefLorda = 28000 * 0.23 + 22000 * 0.33 + (imponibile - 50000) * 0.43;
  }

  // ----- Detrazione lavoro dipendente — art. 13 TUIR -----
  let detrLavoro = 0;
  if (imponibile <= 15000) {
    detrLavoro = 1955;
  } else if (imponibile <= 28000) {
    detrLavoro = 1910 + 1190 * (28000 - imponibile) / 13000;
  } else if (imponibile <= 50000) {
    detrLavoro = 1910 * (50000 - imponibile) / 22000;
  } else {
    detrLavoro = 0;
  }
  if (imponibile > 25000 && imponibile <= 35000) detrLavoro += 65;

  // ----- Taglio del cuneo fiscale (L. 207/2024, strutturale dal 2025) -----
  // Fino a 20.000 €: somma esente in % del reddito; 20.000–40.000 €: ulteriore detrazione.
  const sommaCuneo = imponibile <= 8500 ? imponibile * 0.071 : imponibile <= 15000 ? imponibile * 0.053 : imponibile <= 20000 ? imponibile * 0.048 : 0;
  const detrCuneo = imponibile <= 20000 || imponibile > 40000 ? 0 : imponibile <= 32000 ? 1000 : 1000 * (40000 - imponibile) / 8000;

  // ----- IRPEF netta -----
  const irpefNetta = Math.max(0, irpefLorda - detrLavoro - detrCuneo);

  // ----- Trattamento integrativo (ex bonus 100 €) -----
  // Fino a 15.000 €: se l'IRPEF lorda supera la detrazione da lavoro (meno 75 €).
  // 15.000–28.000 €: solo se le detrazioni superano l'IRPEF lorda (per un dipendente senza altre detrazioni, quasi mai).
  let integrativo = 0;
  if (imponibile <= 15000 && irpefLorda > detrLavoro - 75) {
    integrativo = 1200;
  } else if (imponibile > 15000 && imponibile <= 28000) {
    integrativo = Math.min(1200, Math.max(0, detrLavoro - irpefLorda));
  }
  const bonus = integrativo + sommaCuneo;

  // ----- Addizionali regionali + comunali -----
  // Range nazionale reale: min Veneto/Trentino 1,23%+0,1% = 1,33%
  //                        max Lazio 3,33% + 0,9% = 4,23%
  const addMin = imponibile * 0.0133;
  const addMax = imponibile * 0.0423;
  const addMedia = imponibile * 0.023; // media nazionale circa 2,3%

  // ----- Netto annuale (range basato su addizionali) -----
  const nettoMassimo = ral - inps - irpefNetta - addMin + bonus;
  const nettoMinimo = ral - inps - irpefNetta - addMax + bonus;
  const nettoMedio = ral - inps - irpefNetta - addMedia + bonus;

  return {
    ral,
    inps: Math.round(inps),
    imponibile: Math.round(imponibile),
    irpefLorda: Math.round(irpefLorda),
    detrLavoro: Math.round(detrLavoro + Math.min(detrCuneo, Math.max(0, irpefLorda - detrLavoro))),
    irpefNetta: Math.round(irpefNetta),
    bonus: Math.round(bonus),
    addMin: Math.round(addMin),
    addMax: Math.round(addMax),
    addMedia: Math.round(addMedia),
    nettoMin: Math.round(nettoMinimo),
    nettoMax: Math.round(nettoMassimo),
    nettoMedio: Math.round(nettoMedio),
    nettoMensile12: Math.round(nettoMedio / 12),
    nettoMensile13: Math.round(nettoMedio / 13),
    nettoMensile14: Math.round(nettoMedio / 14),
    aliquotaEffettiva: ((ral - nettoMedio) / ral * 100).toFixed(1),
    aliquotaMarginale: imponibile <= 28000 ? 23 : (imponibile <= 50000 ? 33 : 43)
  };
}

// =====================================================================
// FORMATTER
// =====================================================================
function fmt(n) {
  return new Intl.NumberFormat('it-IT').format(n);
}

// =====================================================================
// DATI DELLA PAGINA
// =====================================================================
const { ral, prev, next, tutti } = Astro.props;
const calc = calcolaStipendio(ral);

// Calcolo stipendi vicini per la sezione "confronto"
const calcPrev = prev ? calcolaStipendio(prev) : null;
const calcNext = next ? calcolaStipendio(next) : null;

// SEO meta
const ralFmt = fmt(ral);
// Ponte verso la casa: quanto di questo stipendio può andare in affitto o rata (regola prudenziale del 30%).
const nettoMese12 = calc.nettoMedio / 12;
const quotaCasa = Math.round(nettoMese12 * 0.30 / 10) * 10;
const iMese = TASSI.fisso / 100 / 12, nRate = 25 * 12;
const capitale = quotaCasa * (1 - Math.pow(1 + iMese, -nRate)) / iMese;
const IMPORTI_MUTUO = [50000, 60000, 70000, 80000, 90000, 100000, 110000, 120000, 130000, 140000, 150000, 160000, 170000, 180000, 190000, 200000, 220000, 240000, 250000, 270000, 280000, 300000, 320000, 350000, 380000, 400000, 420000, 450000, 480000, 500000];
const mutuoVicino = IMPORTI_MUTUO.reduce((a, b) => (Math.abs(b - capitale) < Math.abs(a - capitale) ? b : a));
const fmtK = (n) => Math.round(n / 1000).toLocaleString('it-IT') + '.000';
// Il numero nel titolo: chi cerca "26000 lordi quanti sono netti" vede la risposta già nel risultato.
const titleSeo = `${ralFmt} euro lordi quanti sono netti? ${fmt(calc.nettoMensile13)} € al mese (2026)`;
const descrSeo = `${ralFmt} € lordi l'anno sono ${fmt(calc.nettoMedio)} € netti: ${fmt(calc.nettoMensile13)} € al mese con 13 mensilità, ${fmt(calc.nettoMensile14)} € con 14. Calcolo 2026 con taglio del cuneo.`;
const color = '#2c5a43';

// Schema.org FAQ data
const faqs = [
  {
    q: `Quanto prendo netto al mese con ${ralFmt} euro lordi all'anno?`,
    a: `Con ${ralFmt} € lordi annui prendi circa ${fmt(calc.nettoMensile13)} € al mese se hai 13 mensilità, ${fmt(calc.nettoMensile14)} € se hai 14 mensilità, oppure ${fmt(calc.nettoMensile12)} € se hai 12 mensilità. Il netto annuale è circa ${fmt(calc.nettoMedio)} €.`
  },
  {
    q: `Quanto pago di tasse con ${ralFmt} euro lordi?`,
    a: `Su una RAL di ${ralFmt} € paghi circa ${fmt(calc.inps)} € di contributi INPS, ${fmt(calc.irpefNetta)} € di IRPEF al netto delle detrazioni e tra ${fmt(calc.addMin)} e ${fmt(calc.addMax)} € di addizionali regionale e comunale (variabili in base a Regione e Comune di residenza). L'aliquota fiscale effettiva totale è circa il ${calc.aliquotaEffettiva}%.`
  },
  {
    q: `Qual è la mia aliquota IRPEF marginale con ${ralFmt} euro lordi?`,
    a: `Con un imponibile fiscale di ${fmt(calc.imponibile)} € la tua aliquota marginale IRPEF è del ${calc.aliquotaMarginale}%. Significa che ogni euro lordo aggiuntivo viene tassato a quel tasso (più contributi INPS e addizionali). È il numero da considerare quando valuti aumenti, premi o versamenti deducibili al fondo pensione.`
  },
  {
    q: `Cambia il netto se vivo in Lombardia, Lazio o Veneto?`,
    a: `Sì, le addizionali regionali variano dall'1,23% (Veneto, Valle d'Aosta, Trentino) al 3,33% (Lazio). Anche le addizionali comunali variano: Milano è allo 0,8%, Roma allo 0,9%, Firenze allo 0,2%. Su una RAL di ${ralFmt} € la differenza tra Regione meno tassata e Regione più tassata è di circa ${fmt(calc.addMax - calc.addMin)} € all'anno.`
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<Layout title={titleSeo} description={descrSeo}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div style="max-width: 880px; margin: 0 auto; padding: 36px 20px 80px;">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" style="font-size: 13px; color: #6f6a5e; margin-bottom: 18px;">
      <a href="/" style="color: #6f6a5e;">Home</a>
      <span style="margin: 0 6px; color: #d6cfc1;">›</span>
      <a href="/calcolo-stipendio" style="color: #6f6a5e;">Calcolo Stipendio</a>
      <span style="margin: 0 6px; color: #d6cfc1;">›</span>
      <span style="color: #17150f; font-weight: 600;">{ralFmt} € lordi</span>
    </nav>

    <!-- Header -->
    <header class="tool-head">
      <p class="eyebrow">Strumento</p>
      <h1 class="display tool-title">Stipendio netto da <span style={`color: ${color};`}>{ralFmt} € lordi</span></h1>
    </header>
    <p style="color: #8f897c; font-size: 13px; margin: 0 0 28px 0;">Calcolo aggiornato Legge di Bilancio 2026 · IRPEF 23/33/43% · INPS 9,19%</p>

    <!-- BIG NUMBER CARD -->
    <div style={`background: linear-gradient(135deg, ${color} 0%, #2c5a43 100%); border-radius: 24px; padding: 32px; color: #fbfaf7; margin-bottom: 28px; box-shadow: 0 12px 32px rgba(44,90,67,0.25);`}>
      <div style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.9; margin-bottom: 8px;">Il tuo netto mensile (stima nazionale)</div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 18px;">
        <div>
          <div style="font-size: 11px; opacity: 0.85; margin-bottom: 4px;">12 mensilità</div>
          <div style="font-family: var(--f-display); font-size: 28px; font-weight: 800;">€ {fmt(calc.nettoMensile12)}</div>
        </div>
        <div>
          <div style="font-size: 11px; opacity: 0.85; margin-bottom: 4px;">13 mensilità</div>
          <div style="font-family: var(--f-display); font-size: 28px; font-weight: 800;">€ {fmt(calc.nettoMensile13)}</div>
        </div>
        <div>
          <div style="font-size: 11px; opacity: 0.85; margin-bottom: 4px;">14 mensilità</div>
          <div style="font-family: var(--f-display); font-size: 28px; font-weight: 800;">€ {fmt(calc.nettoMensile14)}</div>
        </div>
      </div>
      <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.2); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
          <div style="font-size: 11px; opacity: 0.85;">Netto annuale</div>
          <div style="font-size: 18px; font-weight: 700;">€ {fmt(calc.nettoMin)} – {fmt(calc.nettoMax)}</div>
        </div>
        <div>
          <div style="font-size: 11px; opacity: 0.85;">Aliquota effettiva</div>
          <div style="font-size: 18px; font-weight: 700;">~{calc.aliquotaEffettiva}%</div>
        </div>
        <div>
          <div style="font-size: 11px; opacity: 0.85;">Aliquota marginale</div>
          <div style="font-size: 18px; font-weight: 700;">{calc.aliquotaMarginale}%</div>
        </div>
      </div>
    </div>

    <!-- Intro testuale (unico per ogni pagina, ricco di keyword) -->
    <p style="color: #47433a; font-size: 16px; line-height: 1.7; margin-bottom: 28px;">
      Se hai un contratto di lavoro dipendente con una <strong>Retribuzione Annua Lorda di {ralFmt} euro</strong>, in busta paga ti restano circa <strong>{fmt(calc.nettoMensile13)} € al mese</strong> con 13 mensilità (l'ipotesi più comune per il CCNL del commercio, metalmeccanico industria, terziario), oppure <strong>{fmt(calc.nettoMensile14)} €</strong> se il tuo contratto prevede anche la quattordicesima. La cifra esatta dipende da Regione e Comune di residenza, dalle detrazioni per familiari a carico e da eventuali bonus o fringe benefit. Sotto trovi il dettaglio completo di come si arriva a questo numero, con tutte le voci di tasse e contributi calcolate sulla normativa fiscale italiana 2026.
    </p>

    <!-- BREAKDOWN -->
    <div class="info-card" style="margin-bottom: 16px;">
      <h2 style={`color: ${color}; font-family: var(--f-display); font-size: 22px; margin: 0 0 18px 0;`}>Dal lordo al netto: ogni voce</h2>

      <div style="display: flex; flex-direction: column; gap: 0;">
        <div class="brk-row brk-row-positive">
          <div>
            <div class="brk-label">Retribuzione Annua Lorda (RAL)</div>
            <div class="brk-sub">Stipendio prima di tasse e contributi</div>
          </div>
          <div class="brk-value">€ {fmt(calc.ral)}</div>
        </div>

        <div class="brk-row brk-row-negative">
          <div>
            <div class="brk-label">– Contributi INPS dipendente</div>
            <div class="brk-sub">9,19% del lordo {ral > 56224 ? '+ 1% sulla quota oltre €56.224' : ''}</div>
          </div>
          <div class="brk-value">– € {fmt(calc.inps)}</div>
        </div>

        <div class="brk-row brk-row-info">
          <div>
            <div class="brk-label">= Imponibile fiscale</div>
            <div class="brk-sub">Base per il calcolo IRPEF</div>
          </div>
          <div class="brk-value">€ {fmt(calc.imponibile)}</div>
        </div>

        <div class="brk-row brk-row-negative">
          <div>
            <div class="brk-label">– IRPEF lorda</div>
            <div class="brk-sub">Scaglioni 2026: 23% fino a 28k, 33% tra 28k–50k, 43% oltre</div>
          </div>
          <div class="brk-value">– € {fmt(calc.irpefLorda)}</div>
        </div>

        <div class="brk-row brk-row-positive">
          <div>
            <div class="brk-label">+ Detrazioni lavoro dipendente</div>
            <div class="brk-sub">Art. 13 TUIR, più l'ulteriore detrazione del taglio del cuneo tra 20.000 e 40.000 €</div>
          </div>
          <div class="brk-value">+ € {fmt(calc.detrLavoro)}</div>
        </div>

        {calc.bonus > 0 && (
          <div class="brk-row brk-row-positive">
            <div>
              <div class="brk-label">+ Somme esenti in busta</div>
              <div class="brk-sub">Taglio del cuneo fino a 20.000 € e trattamento integrativo fino a 15.000 €, esenti da IRPEF</div>
            </div>
            <div class="brk-value">+ € {fmt(calc.bonus)}</div>
          </div>
        )}

        <div class="brk-row brk-row-negative">
          <div>
            <div class="brk-label">– Addizionali regionale + comunale</div>
            <div class="brk-sub">Range nazionale: 1,33% (Veneto/TAA) – 4,23% (Lazio)</div>
          </div>
          <div class="brk-value">– € {fmt(calc.addMin)} / {fmt(calc.addMax)}</div>
        </div>

        <div class="brk-row brk-row-total">
          <div>
            <div class="brk-label" style="font-size: 16px;">= Netto annuale</div>
            <div class="brk-sub">Range in base alla Regione di residenza</div>
          </div>
          <div class="brk-value" style={`font-size: 22px; color: ${color};`}>€ {fmt(calc.nettoMin)} – {fmt(calc.nettoMax)}</div>
        </div>
      </div>
    </div>

    <!-- CTA al calcolatore principale -->
    <div style={`background: #f5f2ec; border: 2px dashed ${color}40; border-radius: 16px; padding: 22px; text-align: center; margin-bottom: 32px;`}>
      <div style="font-size: 14px; color: #47433a; margin-bottom: 12px;">Vuoi il calcolo esatto sulla <strong>tua Regione e Comune</strong>, con detrazioni per familiari e premi?</div>
      <a href="/calcolo-stipendio" style={`display: inline-block; background: ${color}; color: #fbfaf7; padding: 12px 24px; border-radius: 12px; font-weight: 700; font-size: 14px; text-decoration: none;`}>
        Apri il calcolatore personalizzato →
      </a>
    </div>

    <!-- PONTE VERSO LA CASA: quanto puoi spendere per abitare -->
    <div class="info-card" style="margin-bottom: 16px;">
      <h2 style={`color: ${color}; font-family: var(--f-display); font-size: 22px; margin: 0 0 8px 0;`}>Quanto puoi spendere per la casa con {fmt(calc.nettoMensile13)} € al mese</h2>
      <p style="color: #47433a; font-size: 15px; line-height: 1.6; margin: 0 0 16px 0;">Una regola prudente, simile a quella che usano le banche per concedere un mutuo, è non superare il <strong>30% del netto</strong> tra affitto o rata. Con {ralFmt} € lordi vuol dire circa <strong>{fmt(quotaCasa)} € al mese</strong>, calcolati sul netto annuo diviso per dodici.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 14px;">
        <div class="cmp-card"><div class="cmp-tag">Affitto o rata sostenibile</div><div class="cmp-ral">{fmt(quotaCasa)} € al mese</div><div class="cmp-net">30% del netto mensile</div></div>
        <a href={`/mutuo/${mutuoVicino}-euro-25-anni`} class="cmp-card"><div class="cmp-tag">Mutuo indicativo a 25 anni</div><div class="cmp-ral">circa {fmtK(capitale)} €</div><div class="cmp-net">tasso fisso medio {TASSI.fisso.toLocaleString('it-IT')}% · vedi la rata →</div></a>
        <div class="cmp-card"><div class="cmp-tag">Le medie italiane</div><div class="cmp-ral">{ISTAT.affittoMedio} € · {ISTAT.rataMutuoMedia} €</div><div class="cmp-net">affitto medio · rata media (ISTAT {ISTAT.anno})</div></div>
      </div>
      <p style="color: #6f6a5e; font-size: 13.5px; line-height: 1.55; margin: 0;">Alla rata vanno aggiunte le spese della casa: per una famiglia tipo luce, gas e TARI valgono da sole circa 250 € al mese ai prezzi di fine 2026, prima del condominio (<a href="/costi-casa" style={`color: ${color}; text-decoration: underline;`}>quanto costa mantenere una casa</a>). Per vedere il tuo conto reale, voce per voce, c'è <a href="/casa" style={`color: ${color}; text-decoration: underline;`}>La tua casa</a>, gratis.</p>
    </div>

    <!-- CONFRONTO con stipendi adiacenti -->
    {(calcPrev || calcNext) && (
      <div class="info-card" style="margin-bottom: 16px;">
        <h2 style={`color: ${color}; font-family: var(--f-display); font-size: 22px; margin: 0 0 8px 0;`}>Confronto con stipendi vicini</h2>
        <p style="color: #6f6a5e; font-size: 14px; margin: 0 0 18px 0;">Un piccolo aumento di RAL non sempre porta un aumento proporzionale del netto, per via degli scaglioni IRPEF.</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
          {calcPrev && (
            <a href={`/calcolo-stipendio/${prev}-euro-lordi`} class="cmp-card">
              <div class="cmp-tag">Stipendio precedente</div>
              <div class="cmp-ral">€ {fmt(calcPrev.ral)} lordi</div>
              <div class="cmp-net">≈ € {fmt(calcPrev.nettoMensile13)}/mese (13ª)</div>
              <div class="cmp-diff" style="color: #9b4220;">– € {fmt(calc.nettoMedio - calcPrev.nettoMedio)}/anno netti</div>
            </a>
          )}

          <div class="cmp-card cmp-card-current" style={`border-color: ${color}; background: ${color}08;`}>
            <div class="cmp-tag" style={`color: ${color};`}>Stai guardando questo</div>
            <div class="cmp-ral">€ {ralFmt} lordi</div>
            <div class="cmp-net">≈ € {fmt(calc.nettoMensile13)}/mese (13ª)</div>
            <div class="cmp-diff">€ {fmt(calc.nettoMedio)}/anno netti</div>
          </div>

          {calcNext && (
            <a href={`/calcolo-stipendio/${next}-euro-lordi`} class="cmp-card">
              <div class="cmp-tag">Stipendio successivo</div>
              <div class="cmp-ral">€ {fmt(calcNext.ral)} lordi</div>
              <div class="cmp-net">≈ € {fmt(calcNext.nettoMensile13)}/mese (13ª)</div>
              <div class="cmp-diff" style="color: #2c5a43;">+ € {fmt(calcNext.nettoMedio - calc.nettoMedio)}/anno netti</div>
            </a>
          )}
        </div>
      </div>
    )}

    <!-- FAQ section -->
    <div class="info-card" style="margin-bottom: 16px;">
      <h2 style={`color: ${color}; font-family: var(--f-display); font-size: 22px; margin: 0 0 18px 0;`}>Domande frequenti</h2>
      <div style="display: flex; flex-direction: column; gap: 14px;">
        {faqs.map(f => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>

    <!-- Tutti gli stipendi: link interno per indicizzazione -->
    <div class="info-card" style="margin-bottom: 16px;">
