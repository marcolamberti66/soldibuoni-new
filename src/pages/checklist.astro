---
import Layout from '../layouts/Layout.astro';
import ChecklistRisparmio from '../components/ChecklistRisparmio.jsx';

const color = '#7a5a6e';
---

<Layout title="Checklist Risparmio — 12 Azioni Concrete per Risparmiare | SoldiBuoni" description="12 azioni concrete per risparmiare fino a €4.000/anno su bollette, auto, casa e previdenza. Spunta quelle completate e tieni traccia del tuo progresso.">

  <div style="max-width: 960px; margin: 0 auto; padding: 36px 20px 80px;">

    <header class="tool-head">
      <p class="eyebrow">Strumento</p>
      <h1 class="display tool-title">Checklist <span style={`color: ${color};`}>Salvavita</span></h1>
    </header>

    <p class="update-note">12 azioni ordinate per impatto · Progresso salvato nel tuo browser · Aggiornata aprile 2026</p>

    <p style="font-size: 15px; color: #47433a; line-height: 1.7; margin: 0 0 28px; max-width: 640px;">
      Una cosa al mese, senza stress. Ogni azione ha il risparmio stimato, il tempo richiesto e il link al tool giusto. Spunta quelle completate: il progresso resta salvato nel tuo browser.
    </p>

    <ChecklistRisparmio client:load />

    <div style="margin-top: 32px; padding: 20px 24px; background: linear-gradient(135deg, #e2e8ef 0%, #fbfaf7 60%); border: 1px solid rgba(75,95,134,0.2); border-radius: 20px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;">
      <div style="flex: 1 1 280px;">
        <h4 style="font-size: 16px; font-weight: 800; color: #17150f; margin: 0 0 4px;">Vuoi capire il metodo dietro queste azioni?</h4>
        <p style="font-size: 13px; color: #6f6a5e; margin: 0; line-height: 1.5;">La Guida Risparmio 2026 spiega il perché di ogni strategia, con dati e calcoli reali.</p>
      </div>
      <a href="/guida-risparmio" style="padding: 12px 20px; border-radius: 12px; background: #4b5f86; color: #fbfaf7; font-size: 13px; font-weight: 800; text-decoration: none; white-space: nowrap; box-shadow: 0 6px 16px -4px rgba(75,95,134,0.5);">
        Leggi la guida →
      </a>
    </div>

  </div>

</Layout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .update-note {
    font-size: 12px;
    color: #8f897c;
    margin: 0 0 20px 0;
    padding-left: 2px;
    font-weight: 500;
  }
</style>