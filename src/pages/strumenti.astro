---
import Layout from '../layouts/Layout.astro';
const casa = [
  { href: '/controlla-bolletta', t: 'Controlla la tua bolletta', d: 'Il costo pieno al kWh, la fine del prezzo, stime e conguagli. Dieci secondi, senza registrazione.' },
  { href: '/tari', t: 'La TARI della tua città', d: "Quanto si paga in 110 capoluoghi, e come è cambiata rispetto all'anno prima." },
  { href: '/mutuo', t: 'Simulatore mutuo', d: 'Rata, interessi totali e piano di ammortamento con i tassi di questo mese.' },
  { href: '/affitto-vs-mutuo', t: 'Affitto o mutuo', d: 'Il punto di pareggio tra comprare e restare in affitto.' },
];
const insieme = [
  { href: '/dividi', t: 'Dividi le spese', d: 'Coinquilini, coppia, vacanza: chi deve a chi, con il minimo di bonifici. Senza registrazione.' },
];
const altri = [
  { href: '/calcolo-stipendio', t: 'Stipendio lordo/netto', d: 'Il netto in busta paga con IRPEF, contributi e detrazioni 2026.' },
];
---
<Layout title="Strumenti per la casa: bolletta, TARI, mutuo, dividere le spese | SoldiBuoni" description="Strumenti gratuiti per la casa: controlla la bolletta, la TARI della tua città, la rata del mutuo, affitto o acquisto, dividere le spese. Senza registrazione.">
  <section class="wrap st">
    <p class="eyebrow">Strumenti</p>
    <h1 class="display st-t">Calcoli che<br /><em>valgono una decisione.</em></h1>
    <p class="st-lead">Gratuiti e senza registrazione. Per tenere tutto insieme, bollette, rate e scadenze, c'è <a href="/casa">La tua casa</a>.</p>
    <h2 class="st-h">Per la casa</h2>
    <div class="st-grid">
      {casa.map((s) => <a href={s.href} class="st-c"><span class="st-ct">{s.t}</span><span class="st-cd">{s.d}</span><span class="st-ca" aria-hidden="true">→</span></a>)}
    </div>
    <h2 class="st-h">Vivere insieme</h2>
    <div class="st-grid">
      {insieme.map((s) => <a href={s.href} class="st-c"><span class="st-ct">{s.t}</span><span class="st-cd">{s.d}</span><span class="st-ca" aria-hidden="true">→</span></a>)}
    </div>
    <h2 class="st-h">Lavoro</h2>
    <div class="st-grid">
      {altri.map((s) => <a href={s.href} class="st-c"><span class="st-ct">{s.t}</span><span class="st-cd">{s.d}</span><span class="st-ca" aria-hidden="true">→</span></a>)}
    </div>
  </section>
</Layout>
<style>
  .st { padding-top: clamp(48px, 8vw, 96px); }
  .st-t { font-size: clamp(48px, 7.5vw, 96px); margin: 16px 0 8px; }
  .st-t em { color: var(--brass); }
  .st-lead { font-size: 18px; max-width: 600px; margin-top: 20px; }
  .st-lead a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--brass); text-underline-offset: 3px; }
  .st-h { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); font-weight: 500; margin: 64px 0 18px; }
  .st-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
  .st-c { position: relative; display: flex; flex-direction: column; gap: 8px; min-height: 150px; padding: 24px; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); transition: border-color .25s var(--ease), transform .25s var(--ease); }
  .st-c:hover { border-color: var(--ink); transform: translateY(-2px); }
  .st-ct { font-family: var(--f-display); font-size: 30px; color: var(--ink); line-height: 1.05; padding-right: 30px; }
  .st-cd { font-size: 15px; }
  .st-ca { position: absolute; top: 24px; right: 24px; color: var(--ink-3); }
</style>
