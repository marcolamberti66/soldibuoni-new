---
// Pagina pilastro di una voce di spesa: risposta in apertura, strumenti, guide del gruppo, testo, FAQ.
import Layout from '../layouts/Layout.astro';
import { GUIDE } from '../data/guide.js';
interface Strumento { href: string; t: string; d: string; }
interface Props {
  slug: string; nome: string; title: string; description: string; eyebrow: string; titolo: string; lead: string;
  strumenti?: Strumento[]; guide?: string[]; faq?: { q: string; a: string }[]; aggiornato: string;
}
const { slug, nome, title, description, eyebrow, titolo, lead, strumenti = [], guide = [], faq = [], aggiornato } = Astro.props;
const url = `https://soldibuoni.it/${slug}`;
const elenco = guide.map((s) => GUIDE.find((g) => g.slug === s)).filter(Boolean);
const schema = [
  { '@type': 'CollectionPage', '@id': url, name: nome, url, description, inLanguage: 'it-IT', dateModified: aggiornato,
    hasPart: elenco.map((g) => ({ '@type': 'Article', headline: g.t, url: 'https://soldibuoni.it/guida/' + g.slug })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'SoldiBuoni', item: 'https://soldibuoni.it/' },
    { '@type': 'ListItem', position: 2, name: nome, item: url } ] },
  ...(faq.length ? [{ '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) }] : []),
];
---
<Layout title={title} description={description} schema={schema}>
  <section class="hb wrap">
    <nav class="hb-bc" aria-label="Percorso"><a href="/">SoldiBuoni</a> <span aria-hidden="true">/</span> {nome}</nav>
    <header class="hb-hd">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display hb-t" set:html={titolo} />
      <p class="hb-lead" set:html={lead} />
      <p class="hb-meta">Aggiornato a <time datetime={aggiornato}>{new Date(aggiornato).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' })}</time></p>
    </header>

    {strumenti.length > 0 && (
      <div class="hb-tools" aria-label="Calcola il tuo caso">
        {strumenti.map((s, i) => (
          <a href={s.href} class={'hb-tool' + (i === 0 ? ' main' : '')}>
            <span class="hb-tool-t">{s.t}</span>
            <span class="hb-tool-d">{s.d}</span>
            <span class="hb-tool-a" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    )}

    <div class="hb-body">
      <div class="prose"><slot /></div>
      {elenco.length > 0 && (
        <aside class="hb-side" aria-labelledby={`g-${slug}`}>
          <h2 id={`g-${slug}`} class="hb-side-h">Le guide</h2>
          <ul class="hb-gl">
            {elenco.map((g) => (
              <li><a href={`/guida/${g.slug}`}><span class="hb-gl-t">{g.t}</span><span class="hb-gl-d">{g.d}</span></a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    {faq.length > 0 && (
      <section class="hb-faq prose" aria-labelledby={`faq-${slug}`}>
        <h2 id={`faq-${slug}`}>Domande frequenti</h2>
        {faq.map((f) => (<><h3>{f.q}</h3><p set:html={f.a} /></>))}
      </section>
    )}

    <section class="hb-cta">
      <p class="display hb-cta-t">Tutte le scadenze della casa, in un posto solo.</p>
      <p>Carica bollette, rate e tasse: La tua casa ti avvisa prima di ogni scadenza e ti dice quanto spendi davvero al mese. Gratis, senza pubblicità.</p>
      <a href="/casa" class="btn btn-ink">Apri La tua casa</a>
    </section>
  </section>
</Layout>
<style>
  .hb { padding-top: 40px; }
  .hb-bc { font-size: 14px; color: var(--ink-3); }
  .hb-bc a { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .hb-hd { padding: 28px 0 36px; }
  .hb-t { font-size: clamp(46px, 7.5vw, 96px); line-height: .95; letter-spacing: -0.04em; margin-top: 12px; max-width: 1000px; }
  .hb-t :global(em) { color: var(--brass); }
  .hb-lead { font-size: clamp(18px, 1.9vw, 22px); max-width: 760px; margin-top: 24px; color: var(--ink-2); }
  .hb-meta { font-size: 13px; color: var(--ink-3); margin-top: 16px; }
  .hb-tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; padding-bottom: 44px; border-bottom: 1px solid var(--ink); margin-bottom: 44px; }
  .hb-tool { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 22px 48px 22px 22px; border: 1px solid var(--line-strong); border-radius: var(--r-lg); background: var(--card); color: var(--ink); transition: border-color .2s; }
  .hb-tool:hover { border-color: var(--ink); }
  .hb-tool.main { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .hb-tool-t { font-weight: 600; font-size: 18px; }
  .hb-tool-d { font-size: 14.5px; opacity: .8; }
  .hb-tool-a { position: absolute; right: 20px; top: 22px; font-size: 20px; }
  .hb-body { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 64px; }
  .hb-body .prose > :first-child { margin-top: 0; }
  .hb-side-h { font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-2); font-weight: 500; margin-bottom: 12px; }
  .hb-gl { list-style: none; border-top: 1px solid var(--line-strong); }
  .hb-gl a { display: flex; flex-direction: column; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .hb-gl-t { font-family: var(--f-display); font-size: 21px; line-height: 1.15; color: var(--ink); }
  .hb-gl-d { font-size: 14px; color: var(--ink-3); }
  .hb-gl a:hover .hb-gl-t { text-decoration: underline; text-decoration-color: var(--brass); text-underline-offset: 3px; }
  .hb-faq { margin-top: 24px; }
  .hb-cta { margin-top: 72px; padding: 36px; border: 1px solid var(--ink); border-radius: var(--r-lg); background: var(--card); max-width: 860px; }
  .hb-cta-t { font-size: clamp(28px, 3.4vw, 40px); margin-bottom: 12px; }
  .hb-cta .btn { margin-top: 18px; }
  @media (max-width: 900px) { .hb-body { grid-template-columns: 1fr; gap: 40px; } }
</style>
