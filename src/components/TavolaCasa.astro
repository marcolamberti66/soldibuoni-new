---
// Tavola 01 — sezione architettonica della casa, dove ogni piano è una voce di spesa.
// Interattiva: tocchi un piano e la scheda sotto spiega cos'è, quanto pesa e cosa
// fa SoldiBuoni per quella voce. Il selettore Mutuo/Affitto cambia le fondamenta.
// I numeri sono un esempio dichiarato in didascalia, non medie statistiche.
const piani = [
  { id: 'internet', y: 150, h: 58, label: 'Internet', eur: 31, c: 'var(--c-internet)',
    cosa: 'Fibra o FWA e, spesso, il telefono di casa. Canone fisso, ma i prezzi promozionali scadono e poi salgono.',
    noi: 'Segno la fine della promozione e ti avviso prima che il canone aumenti.',
    guida: '/guida/internet-telefono', g: 'Internet e telefono di casa' },
  { id: 'luce', y: 208, h: 64, label: 'Luce', eur: 66, c: 'var(--c-luce)',
    cosa: 'Energia, trasporto, oneri e imposte. Solo la prima parte dipende davvero dal fornitore.',
    noi: 'Leggo la bolletta da PDF o foto, calcolo il costo pieno per kWh e ti avviso quando scade il prezzo bloccato.',
    guida: '/guida/bolletta-luce', g: 'Come leggere la bolletta della luce' },
  { id: 'gas', y: 272, h: 64, label: 'Gas', eur: 94, c: 'var(--c-gas)',
    cosa: 'Con il riscaldamento autonomo è la voce più stagionale: in inverno può valere tre volte l\'estate.',
    noi: 'Riconosco i consumi stimati e i conguagli, e d\'inverno ti ricordo l\'autolettura.',
    guida: '/guida/bolletta-gas', g: 'Come leggere la bolletta del gas' },
  { id: 'condominio', y: 336, h: 64, label: 'Condominio', eur: 75, c: 'var(--c-condominio)',
    cosa: 'Rate ordinarie decise dal preventivo, più eventuali straordinarie. Arrivano a scadenze fisse.',
    noi: 'Metto le rate nello scadenzario e nel calendario del telefono, così non ti sorprendono.',
    guida: '/guida/spese-condominiali', g: 'Spese condominiali: chi paga cosa' },
  { id: 'acqua', y: 400, h: 40, label: 'Acqua e TARI', eur: 46, c: 'var(--c-acqua)',
    cosa: 'Bollette rare e tributi comunali: poche scadenze l\'anno, facili da dimenticare.',
    noi: 'Le divido in quote mensili, così vedi il costo vero della casa mese per mese.',
    guida: '/guida/tari', g: 'TARI: chi la paga e come si calcola' },
];
const fondamenta = {
  mutuo: { label: 'Mutuo', sub: 'le fondamenta', eur: 780,
    cosa: 'La voce più pesante e più lunga: decenni di rate, con interessi che si possono detrarre al 19% sulla prima casa.',
    noi: 'Ti mostro rate residue, quota interessi e capitale, e la detrazione che recuperi nel 730.',
    guida: '/guida/detrazione-interessi-mutuo', g: 'Detrazione degli interessi del mutuo' },
  affitto: { label: 'Affitto', sub: 'in prestito', eur: 780,
    cosa: 'Canone fisso, con aggiornamento ISTAT se previsto dal contratto. Le scadenze del contratto contano quanto la rata.',
    noi: 'Ti avviso sei mesi prima della fine del contratto, quando c\'è ancora tempo per la disdetta o per trattare.',
    guida: '/guida/costi-casa', g: 'Quanto costa davvero una casa' },
};
const fmt = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const totale = fondamenta.mutuo.eur + piani.reduce((t, p) => t + p.eur, 0);
const romani = ['I', 'II', 'III', 'IV', 'V', 'VI'];
const dati = {
  totale,
  voci: Object.fromEntries([
    ...piani.map((p, i) => [p.id, { ...p, n: romani[i + 1] }]),
  ]),
  fondamenta,
};
---
<figure class="tav" data-tav data-modo="mutuo">
  <div class="tav-top">
    <div class="tav-seg" role="radiogroup" aria-label="La casa è">
      <button type="button" role="radio" aria-checked="true" data-modo-btn="mutuo">Ho il mutuo</button>
      <button type="button" role="radio" aria-checked="false" data-modo-btn="affitto">Sono in affitto</button>
    </div>
    <p class="tav-hint" aria-hidden="true"><span class="tav-dot"></span><span class="tav-hint-t">Scegli un piano</span></p>
  </div>

  <svg viewBox="0 0 520 640" role="group" aria-labelledby="tav-t tav-d">
    <title id="tav-t">Sezione economica di una casa, interattiva</title>
    <desc id="tav-d">Esempio: mutuo o affitto 780 euro al mese, gas 94, condominio 75, luce 66, acqua e TARI 46, internet 31. Totale {fmt(totale)} euro al mese. Seleziona un piano per leggerne la scheda.</desc>
    <defs>
      <pattern id="tratteggio" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" stroke="var(--brass)" stroke-width="1.2" />
      </pattern>
      <pattern id="terreno" width="14" height="14" patternUnits="userSpaceOnUse">
        <circle cx="3" cy="4" r="1" fill="var(--ink-3)" opacity=".5" /><circle cx="10" cy="10" r=".8" fill="var(--ink-3)" opacity=".45" />
      </pattern>
      <radialGradient id="tav-luce" cx="50%" cy="40%" r="70%">
        <stop offset="0" stop-color="#f3d38c" /><stop offset="1" stop-color="#d9a64a" />
      </radialGradient>
    </defs>

    <!-- terreno -->
    <rect x="0" y="440" width="520" height="160" fill="url(#terreno)" opacity=".55" />
    <line x1="0" y1="440" x2="520" y2="440" stroke="var(--ink)" stroke-width="1.4" />

    <!-- fondamenta = mutuo o affitto -->
    <g class="tav-p tav-f" style="--i:0" data-voce="fondamenta" tabindex="0" role="button" aria-pressed="false" aria-label="Fondamenta: 780 euro al mese">
      <rect class="tav-hit" x="0" y="440" width="520" height="122" />
      <rect class="tav-f-hatch" x="30" y="440" width="236" height="120" fill="url(#tratteggio)" stroke="var(--ink)" stroke-width="1.4" />
      <rect class="tav-f-fill" x="30" y="440" width="236" height="120" fill="var(--brass)" opacity=".06" />
      <line class="tav-lead" x1="266" y1="500" x2="296" y2="500" />
      <text class="tav-l" x="304" y="494" data-f-label>Mutuo</text>
      <text class="tav-s" x="304" y="512" data-f-sub>le fondamenta</text>
      <text class="tav-v tav-v-big" x="510" y="508" text-anchor="end"><tspan class="tav-e">€</tspan> 780</text>
    </g>

    <!-- tetto e camino -->
    <path class="tav-line" d="M18 152 L148 52 L278 152" fill="none" />
    <path class="tav-line" d="M30 150 L148 60 L266 150" fill="none" opacity=".35" />
    <rect class="tav-line" x="196" y="76" width="22" height="40" fill="var(--paper)" />
    <g class="tav-fumo" aria-hidden="true">
      <circle cx="207" cy="64" r="5" /><circle cx="214" cy="50" r="6.5" /><circle cx="208" cy="34" r="8" />
    </g>

    <!-- piani -->
    {piani.map((p, i) => (
      <g class="tav-p" style={`--i:${i + 1}`} data-voce={p.id} tabindex="0" role="button" aria-pressed="false" aria-label={`${p.label}: ${p.eur} euro al mese`}>
        <rect class="tav-hit" x="0" y={p.y} width="520" height={p.h} />
        <rect class="tav-room" x="30" y={p.y} width="236" height={p.h} stroke="var(--ink)" stroke-width="1.4" />
        <rect class="tav-band" x="30" y={p.y} width="6" height={p.h} fill={p.c} />
        {p.h > 50 && <>
          <rect class="tav-win" x="70" y={p.y + 16} width="30" height={p.h - 30} />
          <line x1="85" y1={p.y + 16} x2="85" y2={p.y + p.h - 14} stroke="var(--ink)" stroke-width=".6" />
          <rect class="tav-win" x="196" y={p.y + 16} width="30" height={p.h - 30} />
          <line x1="211" y1={p.y + 16} x2="211" y2={p.y + p.h - 14} stroke="var(--ink)" stroke-width=".6" />
        </>}
        {p.h <= 50 && <rect class="tav-win" x="132" y={p.y + 12} width="32" height={p.h - 24} />}
        {i === 3 && <rect class="tav-door" x="130" y={p.y + 14} width="34" height={p.h - 14} fill="none" stroke="var(--ink)" stroke-width="1.2" />}
        <line class="tav-lead" x1="266" y1={p.y + p.h / 2} x2="296" y2={p.y + p.h / 2} />
        <text class="tav-l" x="304" y={p.y + p.h / 2 + 5}>{p.label}</text>
        <text class="tav-v" x="510" y={p.y + p.h / 2 + 6} text-anchor="end"><tspan class="tav-e">€</tspan> {fmt(p.eur)}</text>
      </g>
    ))}

    <!-- quote laterali -->
    <line x1="12" y1="150" x2="12" y2="560" stroke="var(--ink-3)" stroke-width=".8" />
    <line x1="8" y1="150" x2="16" y2="150" stroke="var(--ink-3)" stroke-width=".8" />
    <line x1="8" y1="560" x2="16" y2="560" stroke="var(--ink-3)" stroke-width=".8" />

    <!-- totale -->
    <line x1="296" y1="590" x2="510" y2="590" stroke="var(--ink)" stroke-width="1.4" />
    <text class="tav-l" x="304" y="620">Al mese</text>
    <text class="tav-v tav-v-big" x="510" y="624" text-anchor="end"><tspan class="tav-e">€</tspan> {fmt(totale)}</text>
  </svg>

  <div class="tav-scheda" aria-live="polite">
    <div class="tav-vuota" data-vuota>
      <p class="tav-k"><span>Tav. 01</span> Sezione economica di un trilocale</p>
      <p class="tav-vt">Ogni piano è una voce di spesa. <strong>Toccane uno</strong> per vedere quanto pesa e cosa fa SoldiBuoni per tenerla sotto controllo.</p>
    </div>
    <div class="tav-piena" data-piena hidden>
      <div class="tav-sh">
        <p class="tav-k"><i class="tav-sw" data-s-sw></i><b data-s-label>Luce</b></p>
        <button type="button" class="tav-x" data-chiudi aria-label="Chiudi la scheda">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" /></svg>
        </button>
      </div>
      <p class="tav-num"><span class="num" data-s-eur>€ 66</span><small data-s-quota>al mese · 6% del totale</small></p>
      <i class="tav-bar"><em data-s-bar></em></i>
      <p class="tav-cosa" data-s-cosa></p>
      <p class="tav-noi"><span>In SoldiBuoni</span><span data-s-noi></span></p>
      <a class="tav-link" data-s-guida href="/guida">Leggi la guida</a>
    </div>
  </div>
  <figcaption>Importi di esempio, non medie statistiche. Nella tua casa mettiamo i tuoi.</figcaption>
  <script type="application/json" data-tav-dati set:html={JSON.stringify(dati)} />
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('[data-tav]');
  if (fig) {
    const dati = JSON.parse(fig.querySelector('[data-tav-dati]')!.textContent || '{}');
    const $ = <T extends Element = HTMLElement>(s: string) => fig.querySelector<T>(s)!;
    const piani = [...fig.querySelectorAll<SVGGElement>('[data-voce]')];
    const eur = (n: number) => '€ ' + String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    let attivo: string | null = null;

    // La sera le finestre si accendono.
    const ora = new Date().getHours();
    if (ora >= 18 || ora < 7) fig.classList.add('sera');

    const voce = (id: string) => (id === 'fondamenta'
      ? { ...dati.fondamenta[fig.dataset.modo || 'mutuo'], c: 'var(--brass)' }
      : dati.voci[id]);

    function mostra(id: string | null) {
      attivo = id;
      fig.classList.toggle('scelto', !!id);
      piani.forEach((g) => {
        const on = g.dataset.voce === id;
        g.classList.toggle('on', on);
        g.setAttribute('aria-pressed', String(on));
      });
      $('[data-vuota]').hidden = !!id;
      $('[data-piena]').hidden = !id;
      if (!id) return;
      const v = voce(id);
      $('[data-s-sw]').style.background = v.c;
      $('[data-s-label]').textContent = v.label;
      $('[data-s-eur]').textContent = eur(v.eur);
      const q = Math.round((v.eur / dati.totale) * 100);
      $('[data-s-quota]').textContent = `al mese · ${q}% del totale`;
      $('[data-s-bar]').style.width = q + '%';
      $('[data-s-cosa]').textContent = v.cosa;
      $('[data-s-noi]').textContent = v.noi;
      const a = $<HTMLAnchorElement>('[data-s-guida]');
      a.href = v.guida;
      a.textContent = 'Guida: ' + v.g;
      // Su telefono la scheda sta sotto il disegno: la portiamo in vista se è fuori schermo.
      const box = $('[data-piena]').getBoundingClientRect();
      if (box.bottom > innerHeight) $('[data-piena]').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'end' });
    }

    piani.forEach((g) => {
      const scegli = () => mostra(attivo === g.dataset.voce ? null : g.dataset.voce!);
      g.addEventListener('click', scegli);
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); scegli(); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
          e.preventDefault();
          // In DOM l'ordine è: fondamenta, internet, luce, gas, condominio, acqua.
          // Visivamente il primo piano in alto è internet e in fondo ci sono le fondamenta.
          const ordine = ['internet', 'luce', 'gas', 'condominio', 'acqua', 'fondamenta'];
          const i = ordine.indexOf(g.dataset.voce!);
          const prossimo = ordine[(i + (e.key === 'ArrowDown' ? 1 : -1) + ordine.length) % ordine.length];
          const el = piani.find((p) => p.dataset.voce === prossimo)!;
          el.focus(); mostra(prossimo);
        }
        if (e.key === 'Escape') mostra(null);
      });
    });
    $('[data-chiudi]').addEventListener('click', () => mostra(null));

    fig.querySelectorAll<HTMLButtonElement>('[data-modo-btn]').forEach((b) => b.addEventListener('click', () => {
      const modo = b.dataset.modoBtn!;
      fig.dataset.modo = modo;
      fig.querySelectorAll('[data-modo-btn]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      const f = dati.fondamenta[modo];
      $('[data-f-label]').textContent = f.label;
      $('[data-f-sub]').textContent = f.sub;
      fig.querySelector('[data-voce="fondamenta"]')!.setAttribute('aria-label', `${f.label}: ${f.eur} euro al mese`);
      mostra('fondamenta');
    }));
  }
</script>

<style>
  .tav { margin: 0; }
  .tav svg { width: 100%; height: auto; overflow: visible; display: block; }

  .tav-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .tav-seg { display: inline-flex; padding: 3px; border-radius: 999px; background: var(--paper-2); border: 1px solid var(--line); }
  .tav-seg button { border: 0; background: transparent; color: var(--ink-2); font-size: 13.5px; font-weight: 500; padding: 8px 14px; border-radius: 999px; cursor: pointer; transition: background .25s var(--ease), color .25s var(--ease); }
  .tav-seg button[aria-checked='true'] { background: var(--ink); color: var(--paper); }
  .tav-seg button:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }
  .tav-hint { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-2); transition: opacity .3s var(--ease); }
  .tav.scelto .tav-hint { opacity: 0; }
  .tav-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--brass); box-shadow: 0 0 0 0 rgba(132, 101, 45, .5); animation: tavPulse 2s infinite; }
  @keyframes tavPulse { 70% { box-shadow: 0 0 0 9px rgba(132, 101, 45, 0); } 100% { box-shadow: 0 0 0 0 rgba(132, 101, 45, 0); } }

  .tav-line { stroke: var(--ink); stroke-width: 1.4; }
  .tav-lead { stroke: var(--ink-3); stroke-width: .8; stroke-dasharray: 2 3; transition: stroke .3s var(--ease); }
  .tav-l { font-family: var(--f-ui); font-size: 15px; fill: var(--ink); font-weight: 500; }
  .tav-s { font-family: var(--f-display); font-style: italic; font-size: 14px; fill: var(--brass); }
  .tav-v { font-family: var(--f-display); font-size: 23px; font-weight: 500; fill: var(--ink); font-variant-numeric: lining-nums; }
  .tav-e { font-family: var(--f-ui); font-size: .62em; font-weight: 400; fill: var(--ink-3); }
  .tav-v-big { font-size: 30px; }

  /* piani interattivi */
  .tav-p { cursor: pointer; outline: none; animation: tavIn .9s var(--ease) both; animation-delay: calc(var(--i) * 110ms + 150ms); }
  @keyframes tavIn { from { opacity: 0; transform: translateY(10px); } }
  .tav-hit { fill: transparent; }
  .tav-room { fill: var(--paper); transition: fill .3s var(--ease); }
  .tav-band { transition: width .35s var(--ease); }
  .tav-win { fill: var(--paper); stroke: var(--ink); stroke-width: 1; transition: fill .45s var(--ease); }
  .tav-p > text, .tav-p > .tav-room, .tav-p > .tav-band, .tav-f-hatch { transition: opacity .3s var(--ease); }
  .tav-p:hover .tav-room { fill: var(--card); }
  .tav-p:hover .tav-lead, .tav-p.on .tav-lead { stroke: var(--ink); stroke-dasharray: none; }
  .tav-p:focus-visible .tav-room, .tav-p:focus-visible .tav-f-hatch { stroke: var(--brass); stroke-width: 2.4; }
  .tav-p.on .tav-room { fill: var(--card); }
  .tav-p.on .tav-band { width: 12px; }
  .tav-p.on .tav-win { fill: url(#tav-luce); }
  .tav-p.on .tav-f-fill { opacity: .16; }
  .tav.scelto .tav-p:not(.on) > :not(.tav-hit):not(.tav-lead) { opacity: .38; }
  .tav.sera .tav-win { fill: #f1dfb4; }
  .tav.sera .tav-p.on .tav-win { fill: url(#tav-luce); }

  /* affitto: fondamenta tratteggiate, "in prestito" */
  .tav[data-modo='affitto'] .tav-f-hatch { stroke-dasharray: 6 5; fill: none; }
  .tav[data-modo='affitto'] .tav-f-fill { opacity: .03; }

  /* fumo dal camino */
  .tav-fumo circle { fill: none; stroke: var(--ink-3); stroke-width: .9; opacity: 0; animation: tavFumo 5s infinite; }
  .tav-fumo circle:nth-child(2) { animation-delay: 1.2s; }
  .tav-fumo circle:nth-child(3) { animation-delay: 2.4s; }
  @keyframes tavFumo { 0% { opacity: 0; transform: translateY(6px); } 30% { opacity: .55; } 100% { opacity: 0; transform: translateY(-14px); } }

  /* scheda */
  .tav-scheda { margin-top: 20px; border-top: 1px solid var(--ink); padding-top: 16px; min-height: 196px; }
  .tav-k { font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); display: flex; gap: 10px; align-items: baseline; margin: 0; }
  .tav-k span { font-family: var(--f-display); font-style: italic; text-transform: none; letter-spacing: 0; font-size: 17px; color: var(--brass); }
  .tav-k b { font-weight: 600; color: var(--ink); }
  .tav-sw { width: 10px; height: 10px; border-radius: 2px; align-self: center; }
  .tav-vt { font-size: 16px; line-height: 1.55; color: var(--ink-2); margin: 10px 0 0; max-width: 440px; }
  .tav-vt strong { color: var(--ink); }
  .tav-piena { animation: tavScheda .35s var(--ease); }
  @keyframes tavScheda { from { opacity: 0; transform: translateY(6px); } }
  .tav-sh { display: flex; justify-content: space-between; align-items: center; }
  .tav-x { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line-strong); background: transparent; color: var(--ink); cursor: pointer; }
  .tav-x:hover { background: var(--card); }
  .tav-num { display: flex; align-items: baseline; gap: 12px; margin: 8px 0 10px; }
  .tav-num .num { font-family: var(--f-display); font-size: 40px; line-height: 1; color: var(--ink); letter-spacing: -0.02em; }
  .tav-num small { font-size: 13.5px; color: var(--ink-2); }
  .tav-bar { display: block; height: 4px; border-radius: 999px; background: var(--paper-2); overflow: hidden; margin-bottom: 14px; }
  .tav-bar em { display: block; height: 100%; background: var(--brass); border-radius: 999px; transition: width .5s var(--ease); }
  .tav-cosa { font-size: 15.5px; line-height: 1.55; color: var(--ink-2); margin: 0 0 12px; }
  .tav-noi { display: grid; gap: 3px; font-size: 15px; line-height: 1.5; color: var(--ink); padding: 12px 14px; background: var(--card); border-left: 3px solid var(--brass); border-radius: 0 var(--r-sm) var(--r-sm) 0; margin: 0 0 12px; }
  .tav-noi span:first-child { font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--brass); font-weight: 600; }
  .tav-link { font-size: 14.5px; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--brass); }
  .tav figcaption { font-size: 12.5px; color: var(--ink-2); margin-top: 14px; }

  @media (max-width: 560px) {
    .tav-l { font-size: 19px; } .tav-s { font-size: 17px; } .tav-v { font-size: 26px; } .tav-v-big { font-size: 34px; }
    .tav-seg button { font-size: 13px; padding: 8px 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tav-p, .tav-piena, .tav-dot, .tav-fumo circle { animation: none; }
  }
</style>
