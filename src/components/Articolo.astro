---
import Layout from '../layouts/Layout.astro';
import { correlate } from '../data/guide.js';
interface Props { title: string; description: string; eyebrow: string; titolo: string; lead: string; aggiornato: string; slug: string; pubblicato?: string; }
const { title, description, eyebrow, titolo, lead, aggiornato, slug, pubblicato = '2026-11-25' } = Astro.props;
const url = `https://soldibuoni.it/guida/${slug}`;
const titoloPiano = titolo.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const schema = [
  {
    '@type': 'Article', '@id': url + '#article', headline: titoloPiano, description,
    inLanguage: 'it-IT', datePublished: pubblicato, dateModified: aggiornato, mainEntityOfPage: url,
    image: 'https://soldibuoni.it/og.png',
    author: { '@id': 'https://soldibuoni.it/#org' }, publisher: { '@id': 'https://soldibuoni.it/#org' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'SoldiBuoni', item: 'https://soldibuoni.it/' },
      { '@type': 'ListItem', position: 2, name: 'Guida', item: 'https://soldibuoni.it/guida' },
      { '@type': 'ListItem', position: 3, name: titoloPiano, item: url },
    ],
  },
];
const altre = correlate(slug);
---
<Layout title={title} description={description} schema={schema} tipo="article">
  <article class="art wrap">
    <nav class="art-bc" aria-label="Percorso"><a href="/">SoldiBuoni</a> <span aria-hidden="true">/</span> <a href="/guida">Guida</a> <span aria-hidden="true">/</span> {eyebrow}</nav>
    <header class="art-hd">
      <h1 class="display art-t" set:html={titolo} />
      <p class="art-lead">{lead}</p>
      <p class="art-meta">Aggiornato a <time datetime={aggiornato}>{new Date(aggiornato).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' })}</time> · Redazione SoldiBuoni</p>
    </header>
    <div class="art-body">
      <div class="prose"><slot /></div>
      <aside class="art-side">
        <div class="art-cta">
          <p class="display art-cta-t">Fallo leggere a noi.</p>
          <p>Carica la bolletta: in dieci secondi vedi quanto paghi davvero al kWh e quando cambia il tuo prezzo. Gratis, senza registrazione.</p>
          <a href="/controlla-bolletta" class="btn btn-ink">Controlla la tua bolletta</a>
          <a href="/casa" class="art-cta-l">Oppure apri la tua casa</a>
        </div>
      </aside>
    </div>
    <section class="art-more" aria-labelledby="leggi-anche">
      <h2 id="leggi-anche" class="art-more-h">Leggi anche</h2>
      <div class="art-more-g">
        {altre.map((g) => (
          <a href={`/guida/${g.slug}`} class="art-more-i">
            <span class="eyebrow">{g.eb}</span>
            <span class="art-more-t">{g.t}</span>
            <span class="art-more-d">{g.d}</span>
          </a>
        ))}
      </div>
    </section>
  </article>
</Layout>
<style>
  .art { padding-top: 40px; }
  .art-bc { font-size: 14px; color: var(--ink-3); }
  .art-bc a { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .art-hd { padding: 28px 0 40px; border-bottom: 1px solid var(--ink); margin-bottom: 40px; }
  .art-t { font-size: clamp(44px, 7vw, 92px); line-height: .95; letter-spacing: -0.04em; max-width: 1000px; }
  .art-t :global(em) { color: var(--brass); }
  .art-lead { font-size: clamp(18px, 1.8vw, 21px); max-width: 680px; margin-top: 26px; color: var(--ink-2); }
  .art-meta { font-size: 13px; color: var(--ink-3); margin-top: 18px; }
  .art-body { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 64px; }
  .art-body .prose > :first-child { margin-top: 0; }
  .art-side { position: relative; }
  .art-cta { position: sticky; top: 100px; background: var(--card); border: 1px solid var(--ink); border-radius: var(--r-lg); padding: 24px; font-size: 15px; }
  .art-cta-t { font-size: 30px; margin-bottom: 10px; }
  .art-cta .btn { margin-top: 18px; width: 100%; justify-content: center; }
  .art-cta-l { display: block; margin-top: 12px; text-align: center; font-size: 14px; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--brass); }
  .art-more { margin-top: 88px; border-top: 1px solid var(--ink); padding-top: 28px; }
  .art-more-h { font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-2); font-weight: 500; margin-bottom: 20px; }
  .art-more-g { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .art-more-i { display: flex; flex-direction: column; gap: 10px; padding: 4px 24px 8px 0; }
  .art-more-i + .art-more-i { padding-left: 24px; border-left: 1px solid var(--line-strong); }
  .art-more-t { font-family: var(--f-display); font-weight: 500; font-size: 24px; line-height: 1.1; letter-spacing: -0.02em; color: var(--ink); }
  .art-more-d { font-size: 14.5px; }
  .art-more-i:hover .art-more-t { font-style: italic; color: var(--brass); }
  .prose :global(.faq h3) { font-family: var(--f-display); font-weight: 500; font-size: 22px; letter-spacing: -0.01em; }
  @media (max-width: 960px) {
    .art-body { grid-template-columns: 1fr; gap: 40px; } .art-cta { position: static; }
    .art-more-g { grid-template-columns: 1fr; }
    .art-more-i, .art-more-i + .art-more-i { padding: 18px 0; border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
